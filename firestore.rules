rules_version = '2';

// 使用者は1人だけ。ログインしたGoogleアカウントのメールアドレスで制限する。
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'i-kato@spark-partners.jp';
    }

    // 取得処理（Cloud Functions）だけが書き込む
    match /buckets/{hour} {
      allow read: if isOwner();
      allow write: if false;
    }
    // 一覧用の目次（取得処理が書く）
    match /days/{key} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /meta/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }
    // 除外ルールの週次集計（GitHub Actions の rule-report が書く）
    match /ruleReports/{week} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /aiUsage/{day} {
      allow read: if isOwner();
      allow write: if false;
    }
    // 会社の台帳（取得処理が書く。Long List・Knowledge Base で使う）
    match /companies/{id} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /companyArticles/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    // 「読む」にした記事の AI の下書き（Cloud Functions が書く）と、利用者のメモ
    match /drafts/{id} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /notes/{id} {
      allow read, write: if isOwner();
    }
    // 画面から Cloud Functions への依頼（AIの下書き・受け渡し・音声メモ）。結果は Cloud Functions が書く
    match /jobs/{job} {
      allow read, create: if isOwner();
      allow update, delete: if false;
      match /parts/{part} {
        allow create: if isOwner();
        allow read, update, delete: if false;
      }
    }
    // Knowledge Base への受け渡し（Cloud Functions が書く）
    match /handoff/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    // ---- Knowledge Base（ItaruKato/knowledge）のデータ ----
    // 整理した記事・会社・テーマ・レポートは Knowledge Base の Cloud Functions だけが書く
    match /kbArticles/{id} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /kbCompanies/{id} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /kbThemes/{id} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /kbReports/{id} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /kbMeta/{doc} {
      allow read: if isOwner();
      allow write: if false;
    }
    // 記事の本文（大きいので kbArticles と分ける）
    match /kbBodies/{id} {
      allow read: if isOwner();
      allow write: if false;
    }
    // 画面からの依頼（質問・テーマの承認など）。結果は Cloud Functions が書く（画面から関数を直接呼ばない）
    match /kbJobs/{job} {
      allow read, create: if isOwner();
      allow update, delete: if false;
    }
    // 画面の設定
    match /kbConfig/{doc} {
      allow read, write: if isOwner();
    }

    // 振り分け（日ごと）と、無期限で残す「読む」「既読」記事
    match /decisions/{day} {
      allow read, write: if isOwner();
    }
    match /saved/{id} {
      allow read, write: if isOwner();
    }

    // 毎朝の通知の送り先（端末ごとの登録）
    match /pushTokens/{id} {
      allow read, write: if isOwner();
    }

    // 画面の設定（自動除外ルールのオン・オフなど）
    match /config/{doc} {
      allow read, write: if isOwner();
    }
  }
}
